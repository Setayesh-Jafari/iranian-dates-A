# Copy to .env.local for development; never commit real credentials.
# Production must supply a real, TLS-protected PostgreSQL URL via a secret manager.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Canonical origin, with no path/query/credentials. SITE_URL is server-only and
# can be supplied at runtime (recommended for Docker). NEXT_PUBLIC_SITE_URL is
# a build-time alternative. HTTPS is required for non-local production hosts.
# SITE_URL=https://your-verified-domain.example
# NEXT_PUBLIC_SITE_URL=https://your-verified-domain.example

# Indexing is deliberately disabled until explicitly enabled and until the
# incoming Host matches SITE_URL. Preview hosts stay noindex.
# SITE_INDEXING_ENABLED=true

# Required in production for public write APIs. Your trusted ingress MUST strip
# this header from client requests and replace it with ONE verified client IP;
# block direct access to the app. Supported: x-real-ip, x-forwarded-for,
# cf-connecting-ip. No list of IPs is accepted. Failure is closed (503).
# RATE_LIMIT_IP_HEADER=x-real-ip

# Optional server-side team notification. Best-effort, not guaranteed delivery;
# only {inquiryId, itemCount, country} is sent, never buyer contact details.
# Leads are stored in PostgreSQL even if this is absent or fails. The buyer
# response can wait up to five seconds for this delivery attempt.
# INQUIRY_WEBHOOK_URL=https://example.invalid/replace-me

# Development/staging only; schema push can alter or delete data. Never use on
# production. Versioned SQL migration is documented in docs/PRODUCTION_READINESS.md.
# RUN_SCHEMA_PUSH=0
# ALLOW_UNSAFE_SCHEMA_PUSH=0

# Sandbox preview only. Set at BUILD time to remove frame restrictions for an
# embedded preview. NEVER enable for public production.
# ALLOW_EMBEDDED_PREVIEW=1

# The seed wipes products, reviews and inquiries. Only use on a disposable
# development DB: ALLOW_DESTRUCTIVE_SEED=1 npm run db:seed
