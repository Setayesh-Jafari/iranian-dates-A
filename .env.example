# ── Server-only (NEVER expose to the browser; NEVER rename to NEXT_PUBLIC_*) ──
# Real database connection string supplied by the deployment environment.
# The value below is a local-development default only — do not use in production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Public (build-time, browser-exposed — values that must be supplied by deployment) ──
# Canonical public site URL used for SEO metadata. Set only after the business
# verifies its domain. If unset, metadata falls back to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://example.com

# ── Docker startup (see docker-entrypoint.sh) ──
# Optional, default 0. Set to 1 ONLY when a development/staging container
# should sync the database schema on startup ('drizzle-kit push', schema
# only — it never seeds or truncates application data).
# RUN_SCHEMA_PUSH=0

# ── Manual development only (never set in production deployments) ──
# src/db/seed.ts TRUNCATEs products, reviews and inquiries. It is a manual
# development command: `ALLOW_DESTRUCTIVE_SEED=1 npm run db:seed`
# (it also refuses to run at all when NODE_ENV=production).
